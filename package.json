{
  "name": "superr-typeeng",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "start": "node --env-file-if-exists=.env --import tsx server/http.ts",
    "lint": "eslint .",
