# Public frontend configuration (safe to expose to the browser)
VITE_API_BASE_URL=
VITE_TURNSTILE_SITE_KEY=

# Optional local Vite dev proxy target for `wrangler dev` (for example http://127.0.0.1:8787)
WORKER_DEV_URL=

# Optional for built-in practice or OpenAI fallback when Workers AI is unavailable.
OPENAI_API_KEY=
# Optional structured-output-capable Responses API model override.
OPENAI_MODEL=gpt-6-luna

# Production Node adapter
HOST=127.0.0.1
PORT=4173
