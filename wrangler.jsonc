{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superr-typeeng",
  "main": "workers/ai/index.ts",
  "compatibility_date": "2026-01-01",
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA_DO",
        "class_name": "DailyQuotaDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DailyQuotaDurableObject"]
    }
  ],
  "ratelimits": [
    {
      "name": "PASSAGE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:4173,http://localhost:4173,https://*.vercel.app,https://superr-typeeng.superr-typeeng.workers.dev"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
